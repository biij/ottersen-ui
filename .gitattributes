# Normalize line endings: LF in the repo and working tree on all platforms
* text=auto eol=lf

# Windows scripts keep CRLF
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Binary files
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.heic binary
*.ico binary
*.pdf binary
*.woff binary
*.woff2 binary
